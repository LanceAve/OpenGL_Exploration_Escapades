	vec3 lightDir = normalize(LightPosition - retFragPos);								// Normalizing light direction for proper dot product result
	vec3 lambertian = dot(retNormal, lightDir) * LightColor;							// Lambertian lighting 
	vec3 refl = reflect(-lightDir, retNormal);
	vec3 specular = pow(max(dot(refl, retViewDirection), 0.0f), SpecularStrength) * SpecularColor;
	vec3 color = (lambertian + specular + AmbientLight) * DiffuseColor;					// add result of light calculations and multiply to object color

	FragColor = vec4(color, 1.0f) * texture(sampler1, retTexCoord);						// calculate final color
