#version 330 // OpenGL version 3.30 (modified the requirement)

in vec3 retNormal;				// replacing color to normal
in vec3 retFragPos;
in vec2 retTexCoord; 
in vec3 retViewDirection;

out vec4 FragColor;	

// Lighting Struct
struct Light 
{
	vec3 position;
	vec3 color;
	vec3 ambientColor;
	vec3 diffuseColor;
	vec3 specularColor;

	// Point Light setup (attenuation)
	float constant;
	float linear;
	float quadratic;

	// spotlight
	vec3 direction;
	float coneAngle;
	float falloff;
};

// Material struct
struct Material 
{
	float specularStrength;

	// contains textures as well for texture-based reflection
	sampler2D diffuseTexture;
	sampler2D specularTexture;
};

uniform Material material;
#define NR_LIGHTS 4
uniform Light light[NR_LIGHTS];

void main() 
{
	vec4 finalColor = vec4(0);

	// spawn lights with varrying colors
	for (int i = 0; i < NR_LIGHTS; i++)
	{
		// Light calculations
		vec3 lightDir = normalize(light[i].position - retFragPos);									// Normalizing light direction for proper dot product result

		// Cone spotlight lighting config
		float a = cos(light[i].coneAngle);
		float d = dot(normalize(light[i].direction), -lightDir);
		
		if (a < d)	// visible inside cone?
		{
			float lambertianStrength = dot(lightDir, retNormal);									// Lambertian lighting 
			vec3 refl = reflect(-lightDir, retNormal);
			float specularStrength = pow(max(dot(retViewDirection, refl), 0.0f), material.specularStrength);

			float distance = length(light[i].position - retFragPos);
			float att = 1.0f / (light[i].constant + light[i].linear * distance + light[i].quadratic * (distance * distance));		// attentuation calculation - light intensity reducation over a distance
			att *= 1 - pow(clamp(a / d, 0.0f, 1.0f), light[i].falloff);														// falloff of light - blur edges as you approach the cone.

			// lighting includes specular greyscale texture, lambertian lighting, ambient lighting, and now attentuation for point light
			vec3 ambient = texture(material.diffuseTexture, retTexCoord).rgb * light[i].ambientColor;
			vec3 lambertian = lambertianStrength * texture(material.diffuseTexture, retTexCoord).rgb * light[i].diffuseColor * att;
			vec3 specular = specularStrength * texture(material.specularTexture, retTexCoord).r * light[i].specularColor * att;

			finalColor += vec4(ambient + lambertian + specular, 1.0f);								// calculate final color
		
		} else {
			vec3 ambient = texture(material.diffuseTexture, retTexCoord).rgb * light[i].ambientColor / NR_LIGHTS;
			FragColor += vec4(ambient, 1.0f);
		}	
	}

	FragColor = finalColor;
}