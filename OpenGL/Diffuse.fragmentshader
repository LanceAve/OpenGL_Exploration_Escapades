#version 330 // OpenGL version 3.30 (modified the requirement)

in vec3 retNormal;				// replacing color to normal
in vec3 retFragPos;
in vec2 retTexCoord; 
in vec3 retViewDirection;

out vec4 FragColor;	

// Lighting Struct
struct Light 
{
	vec3 position;
	vec3 color;
	vec3 ambientColor;
	vec3 diffuseColor;
	vec3 specularColor;
};

// Material struct
struct Material 
{
	float specularStrength;

	// contains textures as well for texture-based reflection
	sampler2D diffuseTexture;
	sampler2D specularTexture;
};

uniform Material material;
uniform Light light;

void main() 
{
	// Light calculations
	vec3 lightDir = normalize(light.position - retFragPos);									// Normalizing light direction for proper dot product result
	float lambertianStrength = dot(lightDir, retNormal);									// Lambertian lighting 
	vec3 refl = reflect(-lightDir, retNormal);
	float specularStrength = pow(max(dot(retViewDirection, refl), 0.0f), material.specularStrength);

	vec3 ambient = texture(material.diffuseTexture, retTexCoord).rgb * light.ambientColor;
	vec3 lambertian = lambertianStrength * texture(material.diffuseTexture, retTexCoord).rgb * light.diffuseColor;
	vec3 specular = specularStrength * texture(material.specularTexture, retTexCoord).r * light.specularColor;

	FragColor = vec4(ambient + lambertian + specular, 1.0f);								// calculate final color
}