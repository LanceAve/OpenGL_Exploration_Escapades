#version 330 // OpenGL version 3.30 (modified the requirement)

in vec3 retNormal;				// replacing color to normal
in vec3 retFragPos;
in vec2 retTexCoord; 

out vec4 FragColor;	

// Lighting
uniform vec3 LightPosition;
uniform vec3 LightDirection;
uniform vec3 LightColor;
uniform vec3 AmbientLight;

// Colors
uniform vec3 DiffuseColor;

// Textures
uniform sampler2D sampler1;
uniform sampler2D sampler2;

void main() 
{
	// Light calculations
	vec3 lightDir = normalize(LightPosition - retFragPos);								// Normalizing light direction for proper dot product result
	vec3 lambertian = dot(retNormal, lightDir) * LightColor;							// Lambertian lighting 
	vec3 finalResult = clamp(lambertian + AmbientLight, 0.0f, 1.0f) * DiffuseColor;		// add result of light calculations and multiply to object color

	FragColor = vec4(finalResult, 1.0f) * texture(sampler1, retTexCoord);				// calculate final color
}