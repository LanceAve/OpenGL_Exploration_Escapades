#version 330 // OpenGL version 3.30 (minimum requirement)

// now updated to have the shader accept projection matrices
in vec3 vertices;		// value sent from application to this attribute
in vec3 normals;		// color replaced to normal in preperation for lighting
in vec2 texCoords;

uniform mat4 WVP;

out vec3 retNormal;		// color replaced by normal to prep for lighting
out vec2 retTexCoord;

void main()
{
	gl_Position = WVP * vec4(vertices, 1.0); 
	// Initial code was used to Pass-through shader, pass positions to next shader
	// Now it transforms the model to scren projection
	
	retNormal = normals;		// adding the normal that I forgot for some reason
	retTexCoord = texCoords;	// texture coordinates (which are in xy coordinates)
}