#version 330 // OpenGL version 3.30 (modified the requirement)

in vec3 retColor;		// MUST use the name as the out variable that's used by the vertex shader
in vec2 retTexCoord; 

out vec4 FragColor;		
uniform sampler2D sampler1;
uniform sampler2D sampler2;

void main() 
{
	// will only load texture, with no color info (for now)
	// FragColor = texture(sampler1, retTexCoord);																	// Example 1 - with textures only (told ya ;)
	FragColor = texture(sampler1, retTexCoord) * vec4(retColor, 1.0f);												// Example 2 - Texture and colors (Whooo!!!)
	// FragColor = mix(texture(sampler1, retTexCoord), texture(sampler2, retTexCoord), 0.3);						// Example 3 - Layering two textures
	// FragColor = mix(texture(sampler1, retTexCoord), texture(sampler2, retTexCoord), 0.3) * vec4(retColor, 1.0f);	// Example 4 - Layer two textures, with colors now
}