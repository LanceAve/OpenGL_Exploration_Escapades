#version 330

in vec3 retColor;
in vec2 retTexCoord;

out vec4 FragColor;

uniform sampler2D sampler1;
uniform sampler2D sampler2;

uniform float Yscale;
uniform float Uscale;
uniform float Vscale;
uniform bool InvertColors;

void main()
{
	vec3 rgb = mix(texture(sampler1, retTexCoord).rgb, texture(sampler2, retTexCoord).rgb, 0.3);

	// RGB -> YUV
	mat3 rgb2yuv = mat3
	(
		 0.299,     0.587,    0.114,
		-0.14713,  -0.28886,  0.436,
		 0.615,    -0.51499, -0.10001
	);
	vec3 yuv = rgb2yuv * rgb;

	// Apply user scaling
	yuv.x *= Yscale;
	yuv.y *= Uscale;
	yuv.z *= Vscale;

	// YUV -> RGB
	mat3 yuv2rgb = mat3(
		1.0,  0.0,      1.13983,
		1.0, -0.39465, -0.58060,
		1.0,  2.03211,  0.0
	);
	vec3 adjustedRGB = yuv2rgb * yuv;

	// Clamp to [0, 1]
	adjustedRGB = clamp(adjustedRGB, 0.0, 1.0);

	// Invert if checkbox enabled
	if (InvertColors)
		adjustedRGB = vec3(1.0) - adjustedRGB;

	FragColor = vec4(adjustedRGB, 1.0);
}